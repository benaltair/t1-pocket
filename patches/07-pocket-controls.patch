diff --git a/variants/heltec_t1/T1PocketButtons.h b/variants/heltec_t1/T1PocketButtons.h
new file mode 100644
index 0000000..4eb557e
--- /dev/null
+++ b/variants/heltec_t1/T1PocketButtons.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <stdint.h>
+
+// The T1's two active-low side switches share one gesture at a time.
+class T1PocketButtons {
+public:
+  enum Keys { Released = 0, Upper = 1, Lower = 2, Both = 3 };
+  enum Event { None, Next, Previous, UpperHold, LowerHold };
+
+  void cancelUntilRelease() { consumed = true; }
+  bool isPressed() const { return raw != Released || stable != Released; }
+
+  Event poll(Keys sample, uint32_t now) {
+    if (sample != raw) {
+      raw = sample;
+      changedAt = now;
+    }
+    // Suppress overlapping presses even if the overlap is shorter than debounce.
+    if (raw == Both || (raw != Released && stable != Released && raw != stable))
+      cancelUntilRelease();
+    if (now - changedAt < 25) return None;
+
+    if (raw != stable) {
+      Keys previous = stable;
+      stable = raw;
+      if (stable == Released) {
+        bool tap = !consumed;
+        consumed = false;
+        if (tap && previous == Upper) return Next;
+        if (tap && previous == Lower) return Previous;
+      } else {
+        pressedAt = changedAt;
+      }
+    }
+
+    if (stable == Released) {
+      consumed = false;
+    } else if (!consumed && now - pressedAt >= 1000) {
+      consumed = true;
+      return stable == Upper ? UpperHold : LowerHold;
+    }
+    return None;
+  }
+
+private:
+  Keys raw = Released, stable = Released;
+  uint32_t changedAt = 0, pressedAt = 0;
+  bool consumed = false;
+};
