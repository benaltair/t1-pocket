+void MyMesh::cancelPocketRequest(const mesh::Packet* expected, const uint8_t tag[4]) {
+  for (int i = 0; i < _mgr->getOutboundTotal(); ++i) {
+    auto pkt = _mgr->getOutboundByIdx(i);
+    if (pkt == expected && pkt->getPayloadType() == PAYLOAD_TYPE_CONTROL && pkt->payload_len == 6 &&
+        pkt->payload[0] == CTL_TYPE_NODE_DISCOVER_REQ && memcmp(pkt->payload + 2, tag, 4) == 0) {
+      releasePacket(_mgr->removeOutboundByIdx(i));
+      break;
+    }
+  }
+}
