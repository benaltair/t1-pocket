diff --git a/variants/heltec_t1/T1CompanionClock.h b/variants/heltec_t1/T1CompanionClock.h
--- a/variants/heltec_t1/T1CompanionClock.h
+++ b/variants/heltec_t1/T1CompanionClock.h
@@ -14,6 +14,15 @@
 public:
   static bool plausible(uint32_t utc) {
     return utc >= 1735689600UL && utc < 2556144000UL; // 2025 through 2050 UTC
+  }
+
+  // Keep legacy flash records intact. A future modification time is historical
+  // data, included on a full refresh but never a high-water mark for new edits.
+  uint32_t contactTimeForClient(uint32_t stored) const {
+    return stored > seconds || stored >= 2556144000UL ? 1 : stored;
+  }
+  uint32_t contactCursorFromClient(uint32_t since) const {
+    return since > seconds || since >= 2556144000UL ? 0 : since;
   }
 
   bool isSynced() const { return synced && plausible(seconds); }
