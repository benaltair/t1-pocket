index d7e3c1a..a375359 100644
--- a/src/helpers/sensors/MicroNMEALocationProvider.h
+++ b/src/helpers/sensors/MicroNMEALocationProvider.h
@@ -80,6 +80,54 @@ class MicroNMEALocationProvider : public LocationProvider {
     bool _nmea_seen = false;
     bool _fix_seen = false;
 
+#ifdef T1_POCKET_UI
+    bool _have_position = false;
+    int32_t _position_lat = 0, _position_lon = 0;
+    uint32_t _position_seconds = 0;
+
+    static uint32_t uptimeSeconds() {
+        // The nRF52 core converts 1024 Hz ticks to millis(). Use the RTOS wrap
+        // count as well, so a long-lost fix never looks new at tick rollover.
+        static_assert(sizeof(TickType_t) == 4, "Review T1 GPS tick width");
+        TimeOut_t stamp;
+        vTaskSetTimeOutState(&stamp);
+        const uint64_t ticks = (uint64_t(uint32_t(stamp.xOverflowCount)) << 32) | stamp.xTimeOnEntering;
+        return uint32_t(ticks / configTICK_RATE_HZ);
+    }
+
+    // MicroNMEA accepts empty coordinate fields as zero. Require both actual
+    // degree/minute fields and their hemisphere letters, including at (0, 0).
+    static bool hasCoordinate(const char*& field, unsigned degrees, char positive, char negative) {
+        if (!field) return false;
+        for (unsigned i = 0; i < degrees + 2; ++i) {
+            if (*field < '0' || *field > '9' || (i == degrees && *field > '5')) return false;
+            ++field;
+        }
+        if (*field == '.') {
+            ++field;
+            if (*field < '0' || *field > '9') return false;
+            while (*field >= '0' && *field <= '9') ++field;
+        }
+        if (*field++ != ',' || (*field != positive && *field != negative)) return false;
+        if (*++field != ',') return false;
+        ++field;
+        return true;
+    }
+
+    void rememberPosition(bool rmc) {
+        const char* field = MicroNMEA::skipField(nmea.getSentence()); // time
+        field = MicroNMEA::skipField(field);
+        if (rmc) field = MicroNMEA::skipField(field); // RMC has a status before latitude
+        if (!hasCoordinate(field, 2, 'N', 'S') || !hasCoordinate(field, 3, 'E', 'W')) return;
+        const long lat = nmea.getLatitude(), lon = nmea.getLongitude();
+        if (lat < -90000000L || lat > 90000000L || lon < -180000000L || lon > 180000000L) return;
+        _position_lat = lat;
+        _position_lon = lon;
+        _position_seconds = uptimeSeconds();
+        _have_position = true;
+    }
+#endif
+
     static uint32_t ageMs(unsigned long timestamp) {
         return (uint32_t)(millis() - timestamp);
     }
@@ -119,6 +167,7 @@ public :
     void begin() override {
 #ifdef T1_POCKET_UI
         _fix_seen = false;
+        _have_position = false;
 #endif
         _begin_calls++;
         claim();
@@ -133,6 +182,7 @@ public :
