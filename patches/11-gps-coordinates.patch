             digitalWrite(_pin_reset, GPS_RESET_ACTIVE);
@@ -149,6 +199,7 @@ public :
     void stop() override {
 #ifdef T1_POCKET_UI
         _fix_seen = false;
+        _have_position = false;
 #endif
         _stop_calls++;
 #ifdef T1_COMPANION_CLOCK
@@ -184,8 +235,12 @@ public :
     long satellitesCount() override { return nmea.getNumSatellites(); }
     bool isValid() override { return nmea.isValid(); }
 #ifdef T1_POCKET_UI
-    bool hasRecentFix() {
-        return isEnabled() && _fix_seen && isValid() && ageMs(_last_fix_ms) < 5000;
+    bool lastPosition(int32_t& lat, int32_t& lon, uint32_t& ageSeconds) {
+        if (!_have_position || !isEnabled()) return false;
+        lat = _position_lat;
+        lon = _position_lon;
+        ageSeconds = uptimeSeconds() - _position_seconds;
+        return true;
     }
 #endif
 
@@ -251,6 +306,9 @@ public :
                             dated_fix_ms = millis();
                             have_dated_fix = true;
                         }
+#endif
+#ifdef T1_POCKET_UI
+                        rememberPosition(strcmp(message_id, "RMC") == 0);
 #endif
                         _last_fix_ms = millis();
                         _fix_seen = true;
diff --git a/variants/heltec_t1/T1HomeScreen.h b/variants/heltec_t1/T1HomeScreen.h
index 6f26ebb..2378547 100644
--- a/variants/heltec_t1/T1HomeScreen.h
+++ b/variants/heltec_t1/T1HomeScreen.h
@@ -21,6 +21,43 @@ class HomeScreen : public UIScreen {
 
   bool powerOffAfterRelease = false;
 
+  static void drawCoordinate(DisplayDriver& d, int y, int32_t value, char direction) {
+    const uint32_t rounded = (uint32_t(value < 0 ? -value : value) + 5) / 10;
+    char text[16];
+    snprintf(text, sizeof(text), "%lu.%05lu %c", (unsigned long)(rounded / 100000),
+             (unsigned long)(rounded % 100000), direction);
+    d.drawTextLeftAlign(3, y, text);
+  }
+
+  static void drawGps(DisplayDriver& d, bool enabled) {
+    int32_t lat, lon;
+    uint32_t age;
+    d.setTextSize(2);
+    if (enabled && t1LastGpsPosition(lat, lon, age)) {
+      drawCoordinate(d, 15, lat, lat < 0 ? 'S' : 'N');
+      drawCoordinate(d, 29, lon, lon < 0 ? 'W' : 'E');
+      d.setTextSize(1);
+      d.setColor(UIColor::secondary_txt);
+      char text[32] = "Last fix just now";
+      if (age) {
+        uint32_t scale = 1;
+        char unit = 's';
+        if (age >= 86400) { scale = 86400; unit = 'd'; }
+        else if (age >= 3600) { scale = 3600; unit = 'h'; }
+        else if (age >= 60) { scale = 60; unit = 'm'; }
+        snprintf(text, sizeof(text), "Last fix %lu%c ago", (unsigned long)(age / scale), unit);
+      }
+      d.drawTextLeftAlign(3, 42, text);
+    } else {
+      d.drawTextLeftAlign(3, 19, enabled ? "GPS on" : "GPS off");
+      d.setTextSize(1);
+      if (enabled) {
+        d.setColor(UIColor::secondary_txt);
+        d.drawTextLeftAlign(3, 39, "Searching for fix");
+      }
+    }
+  }
+
   static bool validBattery(unsigned mv) {
     return mv >= 2500 && mv <= 4350;
   }
