diff --git a/variants/heltec_t1/T1CompanionClock.h b/variants/heltec_t1/T1CompanionClock.h
new file mode 100644
index 0000000..21ef9e8
--- /dev/null
+++ b/variants/heltec_t1/T1CompanionClock.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <MeshCore.h>
+#include <Arduino.h>
+
+// The T1 has no battery-backed RTC. Only a local sync or a GPS fix can
+// establish UTC after the processor starts. Never use contacts as a clock.
+class T1CompanionClock : public mesh::RTCClock {
+  uint32_t seconds = 1715770351;  // MeshCore's unsynchronised baseline
+  uint32_t previousTick = 0;
+  uint32_t fraction = 0;
+  bool synced = false;
+
+public:
+  static bool plausible(uint32_t utc) {
+    return utc >= 1735689600UL && utc < 2556144000UL; // 2025 through 2050 UTC
+  }
+
+  bool isSynced() const { return synced && plausible(seconds); }
+  uint32_t getCurrentTime() override { return seconds; }
+
+  void setCurrentTime(uint32_t utc) override {
+    if (!plausible(utc)) return;
+    // A grossly incorrect previous clock must not keep generating adverts or
+    // requests with timestamps years ahead after the local time is repaired.
+    if (seconds > utc && seconds - utc > 86400UL) resetUniqueTime();
+    seconds = utc;
+    previousTick = xTaskGetTickCount();
+    fraction = 0;
+    synced = true;
+  }
+
+  void tick() override {
+    static_assert(sizeof(TickType_t) == 4, "Review T1 RTC for a new RTOS tick width");
+    const uint32_t now = xTaskGetTickCount();
+    const uint32_t elapsed = now - previousTick;
+    previousTick = now;
+    // millis() wraps early on this 1024 Hz core. Subtract the raw ticks first.
+    seconds += elapsed / configTICK_RATE_HZ;
+    fraction += elapsed % configTICK_RATE_HZ;
+    seconds += fraction / configTICK_RATE_HZ;
+    fraction %= configTICK_RATE_HZ;
+  }
+};
