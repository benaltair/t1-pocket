diff --git a/variants/heltec_t1/T1CompanionPort.h b/variants/heltec_t1/T1CompanionPort.h
--- a/variants/heltec_t1/T1CompanionPort.h
+++ b/variants/heltec_t1/T1CompanionPort.h
@@ -17,6 +17,7 @@
     ports[1] = &usb;
   }
 
+  bool isUsbOwner() const { return owner == ports[1] && available(owner); }
   bool isConnected() const override { return available(owner); }
   bool isWriteBusy() const override { return isConnected() && owner->isWriteBusy(); }
 
diff --git a/variants/heltec_t1/target.cpp b/variants/heltec_t1/target.cpp
--- a/variants/heltec_t1/target.cpp
+++ b/variants/heltec_t1/target.cpp
@@ -10,7 +10,15 @@
 #ifdef T1_DUAL_COMPANION
 // The framework's default 1200-baud gesture requests serial-only DFU.
 // This board reliably enumerates its removable UF2 volume instead.
-extern "C" void __wrap_enterSerialDfu(void) { enterUf2Dfu(); }
+#include <Adafruit_TinyUSB.h>
+void t1EnterUsbUpdate() {
+  // Give the host time to retire the application CDC device before the
+  // bootloader starts its short USB enumeration window.
+  TinyUSBDevice.detach();
+  delay(500);
+  enterUf2Dfu();
+}
+extern "C" void __wrap_enterSerialDfu(void) { t1EnterUsbUpdate(); }
 #endif
 
 T1Board board;
