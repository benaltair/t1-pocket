diff --git a/variants/heltec_t1/T1CompanionPort.h b/variants/heltec_t1/T1CompanionPort.h
new file mode 100644
--- /dev/null
+++ b/variants/heltec_t1/T1CompanionPort.h
@@ -0,0 +1,51 @@
+#pragma once
+#include <helpers/MultiSerialInterface.h>
+
+// One client owns a companion session. Connecting a charger or opening a
+// serial monitor never claims a session, and replies go only to its owner.
+class T1CompanionPort : public MultiSerialInterface {
+  BaseSerialInterface* ports[2] = {};
+  BaseSerialInterface* owner = nullptr;
+
+  bool available(BaseSerialInterface* port) const {
+    return port && port->isEnabled() && port->isConnected();
+  }
+
+public:
+  void bind(BaseSerialInterface& bluetooth, BaseSerialInterface& usb) {
+    ports[0] = &bluetooth;
+    ports[1] = &usb;
+  }
+
+  bool isConnected() const override { return available(owner); }
+  bool isWriteBusy() const override { return isConnected() && owner->isWriteBusy(); }
+
+  size_t writeFrame(const uint8_t src[], size_t len) override {
+    return isConnected() ? owner->writeFrame(src, len) : 0;
+  }
+
+  void loop() override {
+    MultiSerialInterface::loop();
+    if (!isConnected()) owner = nullptr;
+  }
+
+  void disable() override {
+    owner = nullptr;
+    MultiSerialInterface::disable();
+  }
+
+  size_t checkRecvFrame(uint8_t dest[]) override {
+    if (!isConnected()) owner = nullptr;
+    for (auto* port : ports) {
+      if (!available(port)) continue;
+      // Discard complete requests from the waiting client during an active
+      // session. Its requests must not execute later after a handoff.
+      size_t len = port->checkRecvFrame(dest);
+      if (len && (!owner || port == owner)) {
+        owner = port;
+        return len;
+      }
+    }
+    return 0;
+  }
+};
