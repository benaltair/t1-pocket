diff --git a/variants/heltec_t1/T1BatteryVoltage.h b/variants/heltec_t1/T1BatteryVoltage.h
new file mode 100644
index 0000000..6f3d5f9
--- /dev/null
+++ b/variants/heltec_t1/T1BatteryVoltage.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include "T1BuildSettings.h"
+#include <stdint.h>
+
+// The screen calls this filter only when rendering a visible frame.
+class T1BatteryVoltage {
+  static constexpr unsigned Window = T1Build::batterySamples;
+  uint16_t samples[Window] = {};
+  unsigned count = 0, next = 0;
+  uint32_t lastRead = 0, lastValid = 0;
+  bool sampled = false;
+  bool lastUsb = false;
+
+public:
+  void reset() {
+    count = next = 0;
+    sampled = false;
+  }
+
+  unsigned read(UITask& task, bool usb, uint32_t now) {
+    if (usb != lastUsb) reset();
+    lastUsb = usb;
+    if (!sampled || now - lastRead >= 1000) {
+      if (count && now - lastValid >= 3000) count = next = 0;
+      const unsigned mv = task.getBattMilliVolts();
+      sampled = true;
+      lastRead = now;
+      if (mv >= 2500 && mv <= 4350) {
+        samples[next] = mv;
+        next = (next + 1) % Window;
+        if (count < Window) ++count;
+        lastValid = now;
+      }
+    }
+    if (!count) return 0;
+
+    unsigned sum = 0, low = samples[0], high = samples[0];
+    for (unsigned i = 0; i < count; ++i) {
+      const unsigned mv = samples[i];
+      sum += mv;
+      if (mv < low) low = mv;
+      if (mv > high) high = mv;
+    }
+    unsigned divisor = count;
+    if (count >= 5) {
+      sum -= low + high;
+      divisor -= 2;
+    }
+    return (sum + divisor / 2) / divisor;
+  }
+};
