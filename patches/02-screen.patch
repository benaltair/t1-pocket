diff --git a/variants/heltec_t1/T1HomeScreen.h b/variants/heltec_t1/T1HomeScreen.h
new file mode 100644
index 0000000..a96af6b
--- /dev/null
+++ b/variants/heltec_t1/T1HomeScreen.h
@@ -0,0 +1,151 @@
+#pragma once
+#include "T1BuildSettings.h"
+
+// Included by ui-new after the board, display, mesh and UITask definitions.
+class HomeScreen : public UIScreen {
+  enum Page { Home, GPS, Hibernate, Pairing, Count };
+  UITask* task;
+  NodePrefs* prefs;
+  Page page = Home;
+  bool powerOffAfterRelease = false;
+
+  static bool validBattery(unsigned mv) {
+    return mv >= 2500 && mv <= 4350;
+  }
+
+  static void drawBattery(DisplayDriver& d, unsigned mv, bool usb) {
+    // Coarse voltage bands for the T1's single lithium cell under load.
+    // Charging raises terminal voltage, so show the plug while on USB.
+    d.setColor(UIColor::secondary_txt);
+    d.fillRect(105, 3, 18, 1);
+    d.fillRect(105, 10, 18, 1);
+    d.fillRect(105, 4, 1, 6);
+    d.fillRect(122, 4, 1, 6);
+    d.fillRect(123, 5, 2, 4);
+    if (usb) {
+      d.fillRect(111, 4, 1, 2);
+      d.fillRect(115, 4, 1, 2);
+      d.fillRect(110, 6, 7, 2);
+      d.fillRect(113, 8, 1, 2);
+    } else if (validBattery(mv)) {
+      static const unsigned levels[] = {3450, 3650, 3800, 4000};
+      d.setColor(mv < levels[1] ? UIColor::warning_txt : UIColor::title_txt);
+      for (int bar=0; bar<4 && mv>=levels[bar]; ++bar)
+        d.fillRect(107 + 4*bar, 5, 2, 4);
+    }
+  }
+
+public:
+  HomeScreen(UITask* task, mesh::RTCClock*, SensorManager*, NodePrefs* prefs)
+    : task(task), prefs(prefs) {}
+
+  void resetPage() { page = Home; }
+
+  int render(DisplayDriver& d) override {
+    const bool gps = task->getGPSState();
+    const bool usb = board.isExternalPowered();
+    const unsigned mv = task->getBattMilliVolts();
+    const char* status = gps ? (usb ? "GPS  USB" : "GPS") : (usb ? "USB" : "");
+    d.setTextSize(1);
+    d.setColor(UIColor::secondary_txt);
+    d.drawTextRightAlign(101, 3, status);
+    drawBattery(d, mv, usb);
+    char name[sizeof(prefs->node_name)];
+    d.translateUTF8ToBlocks(name, prefs->node_name, sizeof(name));
+    d.setColor(UIColor::title_txt);
+    d.drawTextEllipsized(3, 3, 94 - d.getTextWidth(status), name);
+    d.setColor(UIColor::title_bkg);
+    d.fillRect(3, 13, 122, 1);
+
+    const char* hint;
+    char detail[32];
+    d.setColor(UIColor::primary_txt);
+    if (page == Home) {
+      if (rtc_clock.isSynced()) {
+        const int utcMinutes = (rtc_clock.getCurrentTime() / 60) % 1440;
+        const int localMinutes = (utcMinutes + T1Build::utcOffsetMinutes + 1440) % 1440;
+        char hhmm[8];
+        snprintf(hhmm, sizeof(hhmm), "%02u:%02u", unsigned(localMinutes/60), unsigned(localMinutes%60));
+        d.setTextSize(2);
+        d.drawTextLeftAlign(3, 19, hhmm);
+        d.setTextSize(1);
+        d.drawTextLeftAlign(55, 24, T1Build::clockLabel);
+      } else {
+        d.setColor(UIColor::warning_txt);
+        d.drawTextLeftAlign(3, 21, "Sync clock with phone");
+      }
+      const int count = task->getMsgCount();
+      snprintf(detail, sizeof(detail), "%d queued", count);
+      d.setTextSize(1);
+      d.setColor(UIColor::secondary_txt);
+      d.drawTextLeftAlign(3, 39, detail);
+      if (validBattery(mv))
+        snprintf(detail, sizeof(detail), "%u.%02u V", mv/1000, (mv%1000)/10);
+      else
+        snprintf(detail, sizeof(detail), "-- V");
+      d.drawTextRightAlign(125, 39, detail);
+      hint = "Hold to send advert";
+    } else if (page == GPS) {
+      d.setTextSize(2);
+      d.drawTextLeftAlign(3, 19, gps ? "GPS on" : "GPS off");
+      d.setTextSize(1);
+      d.setColor(UIColor::secondary_txt);
+      d.drawTextLeftAlign(3, 39, gps ? "Time sync on valid fix" : "Phone can sync time");
+      hint = gps ? "Hold to turn GPS off" : "Hold to turn GPS on";
+    } else if (page == Hibernate) {
+      d.setTextSize(2);
+      d.drawTextLeftAlign(3, 19, "Hibernate");
+      d.setTextSize(1);
+      d.setColor(UIColor::secondary_txt);
+      d.drawTextLeftAlign(3, 39, "Radio will power down");
+      hint = "Hold to hibernate";
+    } else {
+      const uint32_t pin = the_mesh.getBLEPin();
+      if (pin) {
+        snprintf(detail, sizeof(detail), "%06lu", static_cast<unsigned long>(pin));
+        d.setTextSize(2);
+        d.drawTextLeftAlign(3, 19, detail);
+      } else {
+        d.drawTextLeftAlign(3, 22, "PIN unavailable");
+      }
+      d.setTextSize(1);
+      d.setColor(UIColor::secondary_txt);
+      d.drawTextLeftAlign(3, 39, "Bluetooth pairing PIN");
+      hint = "Tap for Home";
+    }
+    d.setColor(UIColor::title_bkg);
+    d.fillRect(3, 49, 122, 1);
+    d.setColor(UIColor::title_txt);
+    d.drawTextLeftAlign(3, 54, hint);
+    for (int i=0; i<Count; ++i) {
+      d.setColor(i == page ? UIColor::title_txt : UIColor::title_bkg);
+      d.fillRect(110+i*5, 56, 3, 2);
+    }
+    return 1000;
+  }
+
+  bool handleInput(char c) override {
+    if (c == KEY_NEXT || c == KEY_PREV) {
+      page = Page((int(page) + (c == KEY_NEXT ? 1 : Count-1)) % Count);
+      return true;
+    }
+    if (c != KEY_ENTER) return false;
+    if (page == Home) {
+      if (!rtc_clock.isSynced()) task->showAlert("Sync clock with phone", 1600);
+      else {
+        task->showAlert(the_mesh.advert(T1Build::floodAdvert) ? "Advert queued" : "Advert queue full", 1200);
+      }
+    } else if (page == GPS) {
+      task->toggleGPS();
+    } else if (page == Hibernate) {
+      powerOffAfterRelease = true;
+    } else {
+      return false;
+    }
+    return true;
+  }
+
+  void poll() override {
+    if (powerOffAfterRelease && !task->isButtonPressed()) task->shutdown();
+  }
+};
