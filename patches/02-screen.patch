@@ -417,6 +417,46 @@ bool ST7735Display::i2c_probe(TwoWire& wire, uint8_t addr) {
   #define PIN_TFT_LEDA_CTL_ACTIVE  HIGH
 #endif
 
+#ifdef T1_POCKET_UI
+#include <HardwarePWM.h>
+static HardwarePWM* backlightPWM = nullptr;
+static const uint32_t backlightOwner = 0x5431424c;
+
+static void turnOnDimBacklight() {
+  for (unsigned i=0; i<HWPWM_MODULE_NUM; ++i) {
+    HardwarePWM* pwm = HwPWMx[i];
+    if (!pwm->takeOwnership(backlightOwner)) continue;
+    if (pwm->addPin(PIN_TFT_LEDA_CTL)) {
+      backlightPWM = pwm;
+      pwm->setResolution(8);
+      pwm->writePin(PIN_TFT_LEDA_CTL, 64, true); // active-low, 25% duty
+      return;
+    }
+    pwm->releaseOwnership(backlightOwner);
+  }
+  digitalWrite(PIN_TFT_LEDA_CTL, PIN_TFT_LEDA_CTL_ACTIVE);
+}
+
+static void releaseBacklight() {
+  digitalWrite(PIN_TFT_LEDA_CTL, !PIN_TFT_LEDA_CTL_ACTIVE);
+  if (backlightPWM) {
+    backlightPWM->stop();
+    backlightPWM->removePin(PIN_TFT_LEDA_CTL);
+    backlightPWM->releaseOwnership(backlightOwner);
+    backlightPWM = nullptr;
+  }
+}
